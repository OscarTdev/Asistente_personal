POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente
POSTGRES_DB=asistente
# Puerto 5433 en el host (solo 127.0.0.1): el 5432 lo ocupa el PostgreSQL local de Windows.
DATABASE_URL=postgresql+psycopg_async://asistente:asistente@127.0.0.1:5433/asistente
REDIS_URL=redis://localhost:6379/0
# 32+ caracteres aleatorios; el texto de ejemplo NO arranca (validador fail-fast)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-32-mas-caracteres

# Canal WhatsApp (Evolution API en Docker)
EVOLUTION_API_KEY=una-clave-larga-para-evolution
# Secreto compartido con el webhook de Evolution (fail-closed sin él):
# configúralo también como cabecera del webhook en Evolution (/webhook/set)
WEBHOOK_SECRET=otra-cadena-larga-y-aleatoria

# LLM: OpenRouter (https://openrouter.ai) o NVIDIA NIM (https://integrate.api.nvidia.com/v1)
# Ambos son compatibles con la interfaz de OpenAI.
LLM_API_KEY=tu-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
