POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente
POSTGRES_DB=asistente
DATABASE_URL=postgresql+psycopg_async://asistente:asistente@127.0.0.1:5433/asistente
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-32-mas-caracteres

# LLM: extraccion con IA (compatible OpenAI; Groq / OpenRouter / NVIDIA NIM)
# Groq (recomendado: rápido y gratis) — key en https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
# Modelo multimodal para describir imágenes recibidas por WhatsApp.
LLM_MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
# Modelo rápido para detección de intención (clasificación, no conversación)
LLM_MODEL_INTENT=meta-llama/llama-3.1-8b-instant

# Evolution API (canal WhatsApp)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=una-clave-larga-para-evolution
EVOLUTION_INSTANCE=aura

# Webhook de WhatsApp (fail-closed: sin secret, la puerta no abre)
# Configúralo también como cabecera del webhook en Evolution (/webhook/set)
WEBHOOK_SECRET=otra-cadena-larga-y-aleatoria

# Audio: STT (Groq gratis en https://console.groq.com)
STT_API_KEY=tu-clave-de-groq
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# TTS: vacío → Edge TTS gratis (es-CO-SalomeNeural); con clave → OpenAI
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=es-CO-SalomeNeural

# Tenant de plataforma (la puerta de los desconocidos)
PLATFORM_TENANT_SLUG=plataforma

# Panel
PANEL_BASE_URL=http://localhost:5173

# Seguimiento de cotizaciones
FOLLOWUP_DAYS=3,7
FOLLOWUP_HOURS=8,19

# Agrupacion de mensajes (debounce)
DEBOUNCE_SECONDS=5
DEBOUNCE_MAX_WAIT=20

# Matching del catalogo (pg_trgm)
CATALOG_SIMILARITY_THRESHOLD=0.30
CATALOG_AMBIGUITY_GAP=0.05

# MercadoPago (pendiente credenciales reales)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=

# Google Workspace (OAuth 2.0): un client de la plataforma y cada dueño
# conecta SU cuenta desde el panel. Pasos: docs/GOOGLE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: vacío → {PANEL_BASE_URL}/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_KEEP_ENABLED=false

# Soporte: número de WhatsApp del admin de la plataforma (formato internacional sin +)
# Ejemplo: 573043223100 (Colombia: 57 + 3043223100)
ADMIN_SUPPORT_WA_ID=573043223100
