POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente
POSTGRES_DB=asistente
# Puerto 5433: el 5432 lo ocupa el servicio PostgreSQL local de Windows.
# 127.0.0.1 (no "localhost"): evita que el relay de WSL (wslrelay.exe en [::1]) intercepte la conexión.
DATABASE_URL=postgresql+psycopg_async://asistente:asistente@127.0.0.1:5433/asistente
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
